<Window x:Class="EdzesKovetoWpf.StatisztikaAblak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statisztika" Height="250" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Heti Teljesítmény Statisztika" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            
            <TextBlock x:Name="OsszesPipaText" Text="Összes feladat: -" Margin="0,5"/>
            <TextBlock x:Name="ElvegezveText" Text="Elvégzett feladatok: -" Margin="0,5"/>
            
            <ProgressBar x:Name="TeljesitmenyBar" Height="20" Margin="0,15,0,5" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="SzazalekText" Text="0%" HorizontalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
