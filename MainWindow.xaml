<Window x:Class="EdzesKovetoWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edzes Koveto Alkalmazas" Height="500" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Uj gyakorlat:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <TextBox x:Name="UjFeladatNevInput" Width="180" VerticalAlignment="Center" Padding="5"/>
                <Button Content="+ Hozzaadas" Click="UjFeladatHozzaadasa_Kattintas" Margin="10,0,0,0" Padding="8,4"/>
            </StackPanel>
            
            <Button Content="Statisztika Megtekintése" Click="StatisztikaAblak_Megnyitas" DockPanel.Dock="Right" Padding="8,4" Background="SteelBlue" Foreground="White" FontWeight="Bold"/>
        </DockPanel>

        <DataGrid Grid.Row="1" x:Name="EdzesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gyakorlat Neve" Binding="{Binding Nev, UpdateSourceTrigger=PropertyChanged}" Width="180"/>

                <DataGridCheckBoxColumn Header="Hetfo" Binding="{Binding Hetfo}" Width="*"/>
                <DataGridCheckBoxColumn Header="Kedd" Binding="{Binding Kedd}" Width="*"/>
                <DataGridCheckBoxColumn Header="Szerda" Binding="{Binding Szerda}" Width="*"/>
                <DataGridCheckBoxColumn Header="Csutortok" Binding="{Binding Csutortok}" Width="*"/>
                <DataGridCheckBoxColumn Header="Pentek" Binding="{Binding Pentek}" Width="*"/>
                <DataGridCheckBoxColumn Header="Szombat" Binding="{Binding Szombat}" Width="*"/>
                <DataGridCheckBoxColumn Header="Vasarnap" Binding="{Binding Vasarnap}" Width="*"/>

                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Torles" Click="FeladatTorlese_Kattintas" Background="IndianRed" Foreground="White"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="StatuszText" Text="Bejelentkezve mint: -" Margin="0,10,0,0" Foreground="Gray"/>
    </Grid>
</Window>
