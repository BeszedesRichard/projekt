<Window x:Class="EdzesKovetoWpf.BejelentkezesAblak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bejelentkezes" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Edzés Követő - Bejelentkezés" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Felhasználó megadása (Név):" Margin="0,0,0,5"/>
            <TextBox x:Name="FelhasznaloNevInput" Padding="5" Margin="0,0,0,15"/>

            <Button Content="Belépés / Regisztráció" Click="Bejelentkezes_Kattintas" Padding="8" Background="DarkGreen" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
